---
import Icon from "../../presentation/components/Icon.astro";
import Page from "../../presentation/layouts/Page.astro";
import { getPostCatalog } from "../../infrastructure/content/posts";
const { tagGroups } = await getPostCatalog();
---

<Page path="/tags" title="タグ">
  <div class="page-heading">
    <h1>
      <Icon name="search" />
      タグ
    </h1>
  </div>
  <ul class="tag-index">
    {tagGroups.map(({ name, slug, count }) => (
      <li>
        <a href={`/tags/${slug}`}>{name}</a>
        <span>{count}件</span>
      </li>
    ))}
  </ul>
</Page>
