---
import { getPostCatalog } from "../../infrastructure/content/posts";
import PostIndex from "../../presentation/views/PostIndex.astro";

export async function getStaticPaths() {
  const { tagGroups } = await getPostCatalog();
  return tagGroups.map(({ name, slug, posts }) => ({
    params: { slug },
    props: { name, posts },
  }));
}
const { name, posts } = Astro.props;
---

<PostIndex
  path={`/tags/${Astro.params.slug}`}
  title={`${name}の記事`}
  heading={name}
  description={`${name}に関する記事一覧。`}
  icon="tag"
  posts={posts}
/>
