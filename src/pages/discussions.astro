---
import { getPostCatalog } from "../infrastructure/content/posts";
import PostIndex from "../presentation/views/PostIndex.astro";
const posts = (await getPostCatalog()).select(["雑談"]);
---

<PostIndex
  path="/discussions"
  title="考察"
  description="考察を集めたページ"
  icon="message-dots"
  posts={posts}
/>
