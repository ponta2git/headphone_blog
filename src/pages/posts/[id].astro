---
import { getImage } from "astro:assets";
import { getPostCatalog, renderPost } from "../../infrastructure/content/posts";
import PostArticle from "../../presentation/views/PostArticle.astro";

export async function getStaticPaths() {
  const catalog = await getPostCatalog();
  return catalog.posts.map((post) => ({
    params: { id: post.id },
    props: catalog.article(post.id),
  }));
}
const { post, adjacent, related } = Astro.props;
const { Content } = await renderPost(post);
const image = post.ogImage
  ? await getImage({
      src: post.ogImage,
      width: Math.min(1200, post.ogImage.width),
      format: "webp",
    })
  : undefined;
const ogImage = image
  ? {
      src: image.src,
      width: Number(image.attributes.width),
      height: Number(image.attributes.height),
    }
  : undefined;
---

<PostArticle post={post} adjacent={adjacent} related={related} image={ogImage}>
  <Content />
</PostArticle>
