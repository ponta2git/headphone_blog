---
import { getPostCatalog } from "../infrastructure/content/posts";
import PostIndex from "../presentation/views/PostIndex.astro";
const posts = (await getPostCatalog()).select(["試聴", "購入"]);
---

<PostIndex
  path="/impressions"
  title="感想"
  description="機材の感想を集めたページ"
  icon="headphones"
  posts={posts}
>
  <p class="page-intro">
    機材の評価基準は<a href="/tags/metric">評価指標の記事</a>にまとめています。
  </p>
</PostIndex>
