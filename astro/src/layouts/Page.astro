---
import { site } from "../lib/blog";
import "../styles/global.css";

interface Props {
  path: string;
  title?: string;
  description?: string;
  published?: string;
  image?: { src: string; width: number; height: number };
  schema?: Record<string, unknown>;
}
const {
  path,
  title,
  description = site.description,
  published,
  image = { src: "/images/logo.webp", width: 512, height: 286 },
  schema,
} = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const canonical = new URL(path, site.url).href;
const imageUrl = new URL(image.src, site.url).href;
const structuredData = {
  "@context": "https://schema.org",
  ...(schema ?? {
    "@type": title ? "CollectionPage" : "WebSite",
    name: title ?? site.name,
    description,
    url: canonical,
  }),
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/webp" href="/images/logo.webp" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={site.name}
      href="/rss.xml"
    />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={published ? "article" : "website"} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={title ?? site.name} />
    {published && (
      <meta property="article:published_time" content={published} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={site.twitter} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replaceAll("<", "\\u003c")}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      本文へ移動
    </a>
    <header class="site-header" id="top" tabindex="-1">
      <div class="container">
        <a class="brand" href="/">
          {site.name}
        </a>
        <p>聴くこと、選ぶこと、楽しむこと。</p>
        <nav aria-label="メインナビゲーション">
          <a href="/" aria-current={path === "/" ? "page" : undefined}>
            新着記事
          </a>
          <a
            href="/all-articles"
            aria-current={path === "/all-articles" ? "page" : undefined}
          >
            記事一覧
          </a>
          <a href="/tags" aria-current={path === "/tags" ? "page" : undefined}>
            タグ
          </a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </header>
    <main class="container" id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer container">
      <p>
        {site.name} / {site.author}
      </p>
      <a href="#top">ページの先頭へ</a>
    </footer>
    <a class="back-to-top" href="#top" data-back-to-top hidden>
      ↑ 上へ戻る
    </a>
    <script>
      import "../scripts/interactions";
    </script>
  </body>
</html>
