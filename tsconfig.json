{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "tests/**/*", "*.ts", "*.mjs"],
  "exclude": [
    "dist",
    "node_modules",
    ".next",
    "out",
    ".playwright-mcp",
    ".pnpm-store",
    ".vercel"
  ],
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "types": ["node"]
  }
}
